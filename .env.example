# Written by `sudo bash deploy/configure.sh secrets` to /etc/commandcode-bot/env (root-only, mode 600).
# For local runs, copy to .env and load it with: set -a; . ./.env; set +a
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_USER_ID=123456789
PROJECTS_FILE=/etc/commandcode-bot/projects.json
COMMAND_CODE_BIN=/usr/bin/cmd
COMMAND_CODE_API_KEY=
STATE_FILE=/var/lib/commandcode-bot/state.json
WORKTREE_ROOT=/home/ccbot/worktrees
RUN_TIMEOUT_SECONDS=900
EDIT_TIMEOUT_SECONDS=2700
DEFAULT_MODEL=
DEFAULT_EFFORT=
EDIT_PERMISSION=auto-accept
