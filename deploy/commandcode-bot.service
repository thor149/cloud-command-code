[Unit]
Description=Cloud Command Code (private Telegram controller for Command Code)
Wants=network-online.target
After=network-online.target
# A configuration error must not restart forever: give up after 5 failures in 10 minutes.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=ccbot
Group=ccbot
WorkingDirectory=/opt/commandcode-bot
EnvironmentFile=/etc/commandcode-bot/env
Environment=HOME=/home/ccbot
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/commandcode-bot/.venv/bin/python -m commandcode_bot.check
ExecStart=/opt/commandcode-bot/.venv/bin/python -m commandcode_bot.bot
StateDirectory=commandcode-bot
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

# Hardening: the agent can write only to the bot user's home (repos, worktrees, caches) and its state.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ccbot /var/lib/commandcode-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
