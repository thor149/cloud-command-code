[Unit]
Description=Private Telegram Command Code controller
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/commandcode-bot
EnvironmentFile=/home/ubuntu/commandcode-bot/.env
ExecStart=/home/ubuntu/commandcode-bot/.venv/bin/python -m commandcode_bot.bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
UMask=0077

[Install]
WantedBy=multi-user.target

